{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://swar.local/contracts/ml-enrollment-control.v1.json",
  "title": "SWAR ephemeral enrollment inference control v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "enrollmentOperationId", "consentId", "expectedModelVersionId", "samples"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "enrollmentOperationId": { "type": "string", "minLength": 8, "maxLength": 128 },
    "consentId": { "type": "string", "format": "uuid" },
    "expectedModelVersionId": { "type": "string", "format": "uuid" },
    "samples": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "contentEncoding": "base64", "contentMediaType": "audio/wav", "writeOnly": true }
    }
  }
}
