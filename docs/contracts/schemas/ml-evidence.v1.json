{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://swar.local/contracts/ml-evidence.v1.json",
  "title": "SWAR ML evidence event v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["eventType", "eventId", "schemaVersion", "organizationId", "callId", "analysisSessionId", "trackBindingId", "eventSequence", "windowSequence", "revision", "evidenceType", "windowStartMs", "windowEndMs", "observedAt"],
  "properties": {
    "eventType": { "enum": ["FAST", "DEEP", "INSUFFICIENT_EVIDENCE", "PIPELINE_ERROR"] },
    "eventId": { "type": "string", "format": "uuid" },
    "schemaVersion": { "const": "1.0.0" },
    "organizationId": { "type": "string", "format": "uuid" },
    "callId": { "type": "string", "format": "uuid" },
    "analysisSessionId": { "type": "string", "format": "uuid" },
    "trackBindingId": { "type": "string", "format": "uuid" },
    "eventSequence": { "type": "string", "pattern": "^\\d+$" },
    "windowSequence": { "type": "string", "pattern": "^\\d+$" },
    "revision": { "type": "integer", "minimum": 0 },
    "evidenceType": { "enum": ["IDENTITY", "SPOOF_FAST", "SPOOF_DEEP", "INSUFFICIENT_EVIDENCE", "PIPELINE_ERROR"] },
    "windowStartMs": { "type": "string", "pattern": "^\\d+$" },
    "windowEndMs": { "type": "string", "pattern": "^\\d+$" },
    "observedAt": { "type": "string", "format": "date-time" },
    "processingLatencyMs": { "type": "integer", "minimum": 0 },
    "speechDurationMs": { "type": "integer", "minimum": 0 },
    "qualityScore": { "type": "number" },
    "reasonCodes": { "type": "array", "items": { "type": "string", "maxLength": 80 } },
    "modelVersionId": { "type": "string", "format": "uuid" },
    "modelName": { "type": "string", "maxLength": 120 },
    "modelVersion": { "type": "string", "maxLength": 80 },
    "checkpointHashSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "scoreName": { "type": "string", "maxLength": 120 },
    "scoreDirection": { "enum": ["HIGHER_MEANS_MORE", "LOWER_MEANS_MORE"] },
    "rawScore": { "type": "number" },
    "calibratedScore": { "type": "number" },
    "calibrationVersion": { "type": "string", "maxLength": 80 },
    "errorCode": { "type": "string", "maxLength": 80 }
  },
  "allOf": [
    {
      "if": { "properties": { "eventType": { "const": "FAST" } }, "required": ["eventType"] },
      "then": { "properties": { "evidenceType": { "enum": ["IDENTITY", "SPOOF_FAST"] } } }
    },
    {
      "if": { "properties": { "eventType": { "const": "DEEP" } }, "required": ["eventType"] },
      "then": { "properties": { "evidenceType": { "const": "SPOOF_DEEP" } } }
    },
    {
      "if": { "properties": { "eventType": { "enum": ["FAST", "DEEP"] } }, "required": ["eventType"] },
      "then": { "required": ["modelName", "modelVersion", "checkpointHashSha256", "scoreName", "scoreDirection", "rawScore"] }
    },
    {
      "if": { "properties": { "eventType": { "const": "INSUFFICIENT_EVIDENCE" } }, "required": ["eventType"] },
      "then": {
        "properties": { "evidenceType": { "const": "INSUFFICIENT_EVIDENCE" }, "reasonCodes": { "minItems": 1 } },
        "required": ["reasonCodes"],
        "not": { "anyOf": [{ "required": ["modelName"] }, { "required": ["modelVersion"] }, { "required": ["checkpointHashSha256"] }, { "required": ["scoreName"] }, { "required": ["scoreDirection"] }, { "required": ["rawScore"] }, { "required": ["calibratedScore"] }, { "required": ["calibrationVersion"] }] }
      }
    },
    {
      "if": { "properties": { "eventType": { "const": "PIPELINE_ERROR" } }, "required": ["eventType"] },
      "then": {
        "properties": { "evidenceType": { "const": "PIPELINE_ERROR" } },
        "required": ["errorCode"],
        "not": { "anyOf": [{ "required": ["modelName"] }, { "required": ["modelVersion"] }, { "required": ["checkpointHashSha256"] }, { "required": ["scoreName"] }, { "required": ["scoreDirection"] }, { "required": ["rawScore"] }, { "required": ["calibratedScore"] }, { "required": ["calibrationVersion"] }] }
      }
    },
    {
      "if": { "required": ["calibratedScore"] },
      "then": { "required": ["calibrationVersion"] }
    }
  ]
}
