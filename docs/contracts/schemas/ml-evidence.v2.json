{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://swar.local/contracts/ml-evidence.v2.json",
  "title": "SWAR exact-binding ML evidence event v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["eventType", "eventId", "schemaVersion", "evidenceMode", "organizationId", "callId", "analysisSessionId", "trackBindingId", "participantIdentity", "trackSid", "windowId", "correlationId", "eventSequence", "windowSequence", "revision", "evidenceType", "windowStartMs", "windowEndMs", "observedAt", "capturedAt"],
  "properties": {
    "eventType": { "enum": ["FAST", "DEEP", "INSUFFICIENT_EVIDENCE", "PIPELINE_ERROR"] },
    "eventId": { "type": "string", "format": "uuid" },
    "schemaVersion": { "const": "2.0.0" },
    "evidenceMode": { "enum": ["SIMULATED", "SHADOW", "CALIBRATED"] },
    "organizationId": { "type": "string", "format": "uuid" },
    "callId": { "type": "string", "format": "uuid" },
    "analysisSessionId": { "type": "string", "format": "uuid" },
    "trackBindingId": { "type": "string", "format": "uuid" },
    "participantIdentity": { "type": "string", "minLength": 1, "maxLength": 160 },
    "trackSid": { "type": "string", "minLength": 1, "maxLength": 128 },
    "windowId": { "type": "string", "minLength": 1, "maxLength": 200 },
    "correlationId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "eventSequence": { "type": "string", "pattern": "^\\d+$" },
    "windowSequence": { "type": "string", "pattern": "^\\d+$" },
    "revision": { "type": "integer", "minimum": 0 },
    "evidenceType": { "enum": ["IDENTITY", "SPOOF_FAST", "SPOOF_DEEP", "INSUFFICIENT_EVIDENCE", "PIPELINE_ERROR"] },
    "windowStartMs": { "type": "string", "pattern": "^\\d+$" },
    "windowEndMs": { "type": "string", "pattern": "^\\d+$" },
    "observedAt": { "type": "string", "format": "date-time" },
    "capturedAt": { "type": "string", "format": "date-time" },
    "inferenceStartedAt": { "type": "string", "format": "date-time" },
    "inferenceCompletedAt": { "type": "string", "format": "date-time" },
    "processingLatencyMs": { "type": "integer", "minimum": 0 },
    "speechDurationMs": { "type": "integer", "minimum": 0 },
    "qualityScore": { "type": "number", "minimum": 0, "maximum": 1 },
    "reasonCodes": { "type": "array", "items": { "type": "string", "maxLength": 80 } },
    "modelVersionId": { "type": "string", "format": "uuid" },
    "modelName": { "type": "string", "maxLength": 120 },
    "modelVersion": { "type": "string", "maxLength": 80 },
    "checkpointHashSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "scoreName": { "type": "string", "maxLength": 120 },
    "scoreDirection": { "enum": ["HIGHER_MEANS_MORE", "LOWER_MEANS_MORE"] },
    "rawScore": { "type": "number" },
    "calibratedScore": { "type": "number", "minimum": 0, "maximum": 1 },
    "calibrationVersion": { "type": "string", "maxLength": 80 },
    "errorCode": { "type": "string", "maxLength": 80 }
  },
  "allOf": [
    { "if": { "properties": { "eventType": { "const": "FAST" } }, "required": ["eventType"] }, "then": { "properties": { "evidenceType": { "enum": ["IDENTITY", "SPOOF_FAST"] } } } },
    { "if": { "properties": { "eventType": { "const": "DEEP" } }, "required": ["eventType"] }, "then": { "properties": { "evidenceType": { "const": "SPOOF_DEEP" } } } },
    { "if": { "properties": { "eventType": { "enum": ["FAST", "DEEP"] } }, "required": ["eventType"] }, "then": { "required": ["modelName", "modelVersion", "checkpointHashSha256", "scoreName", "scoreDirection", "rawScore", "processingLatencyMs", "inferenceStartedAt", "inferenceCompletedAt"] } },
    { "if": { "properties": { "eventType": { "const": "INSUFFICIENT_EVIDENCE" } }, "required": ["eventType"] }, "then": { "properties": { "evidenceType": { "const": "INSUFFICIENT_EVIDENCE" }, "reasonCodes": { "minItems": 1 } }, "required": ["reasonCodes"], "not": { "anyOf": [{ "required": ["modelName"] }, { "required": ["rawScore"] }, { "required": ["calibratedScore"] }] } } },
    { "if": { "properties": { "eventType": { "const": "PIPELINE_ERROR" } }, "required": ["eventType"] }, "then": { "properties": { "evidenceType": { "const": "PIPELINE_ERROR" } }, "required": ["errorCode"], "not": { "anyOf": [{ "required": ["modelName"] }, { "required": ["rawScore"] }, { "required": ["calibratedScore"] }] } } },
    { "if": { "required": ["calibratedScore"] }, "then": { "required": ["calibrationVersion"] } }
  ]
}
