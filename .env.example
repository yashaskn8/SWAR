# SWAR native development configuration. Copy to .env and replace every
# replace_with_* value. Never commit .env or reuse development credentials.
SWAR_ENV=development

# Public/backend endpoints. Set SWAR_LAN_IP to this workstation's LAN IPv4
# when testing from a physical Android device on the same trusted network.
SWAR_LAN_IP=127.0.0.1
BACKEND_HOST=127.0.0.1
BACKEND_PORT=3000
PUBLIC_API_URL=http://127.0.0.1:3000/api/v1
SECURITY_WS_URL=ws://127.0.0.1:3000/ws/security
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:3000
HTTP_BODY_LIMIT_BYTES=100000
HTTP_REQUEST_TIMEOUT_MS=30000
SHUTDOWN_TIMEOUT_MS=10000
API_RATE_LIMIT_WINDOW_SECONDS=60
API_SENSITIVE_RATE_LIMIT_MAX=10
API_MUTATION_RATE_LIMIT_MAX=60
API_QUERY_RATE_LIMIT_MAX=300
SECURITY_WS_REPLAY_MAX_EVENTS=100
SECURITY_WS_SUBSCRIPTION_MAX_CALLS=50
SECURITY_WS_INBOUND_RATE_LIMIT_MAX=60
ENROLLMENT_MAX_SAMPLES=5
ENROLLMENT_MAX_SAMPLE_BYTES=1048576
ENROLLMENT_MAX_TOTAL_BYTES=5242880
ENROLLMENT_MAX_DECLARED_DURATION_MS=30000
STEP_UP_CHALLENGE_TTL_SECONDS=300

# Private ML service. Keep loopback-only in local development.
ML_HOST=127.0.0.1
ML_PORT=8000
APP_ENV=development
# Phase M only: "stub" is accepted only with APP_ENV=development or test.
# Production startup rejects this provider. Phase N/P replace it with verified adapters.
ML_PROVIDER=stub
ML_EVIDENCE_MODE=SIMULATED
# Phase Q is engineering/shadow-only until the scientific and serving promotion records exist.
RISK_INTERVENTION_MODE=ENGINEERING_ONLY
PHASE_O_SCIENTIFIC_STATUS=BLOCKED
PHASE_P_PRODUCTION_STATUS=BLOCKED_BY_PHASE_O
PHASE_Q_PRODUCTION_STATUS=ENGINEERING_ONLY
ML_INTERNAL_URL=http://127.0.0.1:8000
ML_INTERNAL_SECRET=replace_with_random_internal_service_secret
ML_CONTROL_MAX_ATTEMPTS=3
ML_CONTROL_RETRY_BACKOFF_MS=100
INTERNAL_AUTH_CLOCK_SKEW_SECONDS=30
BACKEND_EVIDENCE_URL=http://127.0.0.1:3000/api/v1/internal/ml/evidence
ML_CHECKPOINT_ROOT=checkpoints
ML_MODEL_REGISTRY_PATH=config/model_registry.yaml
ML_AUDIO_CONFIG_PATH=config/audio.yaml
ML_CALIBRATION_PATH=config/calibration.json
ML_MAX_CONCURRENT_SESSIONS=4
ML_FRAME_QUEUE_MAX=32
ML_WINDOW_QUEUE_MAX=4
ML_EVIDENCE_QUEUE_MAX=32
ML_MODEL_TIMEOUT_SECONDS=5
ML_TRACK_BINDING_TIMEOUT_SECONDS=10
ML_CALLBACK_TIMEOUT_SECONDS=3
ML_CALLBACK_MAX_ATTEMPTS=3
ML_RECONNECT_MAX_ATTEMPTS=3
ML_RECONNECT_BACKOFF_MS=250
VERIFICATION_CALLBACK_SECRET=replace_with_random_verification_callback_secret
DOWNSTREAM_HTTP_TIMEOUT_MS=5000
DOWNSTREAM_WEBSOCKET_TIMEOUT_MS=5000

# Native PostgreSQL service and least-privilege application database.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_ADMIN_DATABASE=postgres
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=replace_with_local_postgres_admin_password
POSTGRES_APP_DATABASE=swar
POSTGRES_APP_USER=swar_app
POSTGRES_APP_PASSWORD=replace_with_random_database_password
DATABASE_URL=postgresql://swar_app:replace_with_url_encoded_database_password@127.0.0.1:5432/swar
POSTGRES_POOL_MAX=10
POSTGRES_IDLE_TIMEOUT_MS=10000
POSTGRES_CONNECTION_TIMEOUT_MS=5000

# Native LiveKit server. LIVEKIT_NODE_IP must be a reachable LAN IPv4 for a
# two-device test; keep 127.0.0.1 for loopback-only development.
LIVEKIT_BIND_ADDRESS=127.0.0.1
LIVEKIT_NODE_IP=127.0.0.1
LIVEKIT_PORT=7880
LIVEKIT_RTC_TCP_PORT=7881
LIVEKIT_RTC_UDP_PORT=7882
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=replace_with_random_livekit_api_key
LIVEKIT_API_SECRET=replace_with_random_livekit_api_secret
LIVEKIT_PARTICIPANT_GRANT_TTL_SECONDS=300
ANALYSIS_SESSION_TTL_SECONDS=900

# Phase H validates these cryptographic settings; later owning phases consume them. They are
# documented now so native hosts have one canonical environment contract.
JWT_ACCESS_SECRET=replace_with_random_access_token_secret
JWT_REFRESH_SECRET=replace_with_random_refresh_token_secret
JWT_ISSUER=swar-backend
JWT_AUDIENCE=swar-public-api
JWT_ACCESS_TTL_SECONDS=300
JWT_CLOCK_TOLERANCE_SECONDS=5
REFRESH_SESSION_TTL_SECONDS=604800
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_WINDOW_SECONDS=300
IDEMPOTENCY_TTL_SECONDS=3600
IDEMPOTENCY_MAX_ENTRIES=10000
VOICEPRINT_ENCRYPTION_KEY=replace_with_base64_32_byte_key
VOICEPRINT_ENCRYPTION_KEY_VERSION=development-key-v1

# Optional absolute executable overrides. Leave blank to use PATH, service
# virtual environments, or the per-user %LOCALAPPDATA%\SWAR\tools inventory.
SWAR_NODE_PATH=
SWAR_NPM_PATH=
SWAR_PYTHON_PATH=
SWAR_JAVA_PATH=
SWAR_GRADLE_PATH=
SWAR_PSQL_PATH=
SWAR_PG_ISREADY_PATH=
SWAR_PG_CTL_PATH=
SWAR_INITDB_PATH=
SWAR_LIVEKIT_PATH=
